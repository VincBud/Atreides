# Contact form — copy to .env.local for development and set the same values
# in the Vercel project settings for production. Never commit real values.

# Resend API key (server-only). https://resend.com/api-keys
RESEND_API_KEY=

# Mailbox that receives enquiries. The only place the recipient is configured.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile. The site key is public and shipped to the browser;
# the secret key is server-only and must never be prefixed with NEXT_PUBLIC_.
# Cloudflare's documented test keys are useful locally:
#   site key   1x00000000000000000000AA  (always passes)
#   secret key 1x0000000000000000000000000000000AA  (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
